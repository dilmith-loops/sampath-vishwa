# ----------------------------------------------------------------------
# Apache Configuration for Next.js Static Export on Hostinger
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (Crucial for WebCam & MediaPipe camera permissions)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # If requested path is not a file or directory, check for .html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Security & Permissions for Camera / AR Motion Tracking
<IfModule mod_headers.c>
  Header always set Permissions-Policy "camera=(self), microphone=()"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# Prevent directory indexing
Options -Indexes

# MIME Types for WebAssembly (MediaPipe)
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/json .json
  AddType image/svg+xml .svg
</IfModule>

# Enable GZIP Compression for Fast Loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
