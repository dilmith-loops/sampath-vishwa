# ----------------------------------------------------------------------
# Apache Configuration for Next.js Static Export on Hostinger
# ----------------------------------------------------------------------

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS (Crucial for WebCam & MediaPipe camera permissions)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # If requested path is not a file or directory, check for .html or route to index
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Security & Permissions for Camera / AR Motion Tracking
<IfModule mod_headers.c>
  # Allow camera access for the kiosk and embedded AR frames
  Header always set Permissions-Policy "camera=(self), microphone=()"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Custom 404 Error Page
ErrorDocument 404 /404.html

# MIME Types for Modern Web & WebAssembly (MediaPipe)
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/json .json
  AddType image/svg+xml .svg
</IfModule>

# Enable GZIP Compression for Fast Loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json
</IfModule>
